apiVersion: v1
kind: LimitRange
metadata:
  name: demo-limits
  namespace: {{ namespace }}
  labels:
    {{ label_managed_by }}: {{ managed_by_value }}
spec:
  limits:
    - type: Container
      defaultRequest:
        cpu: 100m
        memory: 128Mi
      default:
        cpu: 300m
        memory: 256Mi
      max:
        cpu: "{{ persona.resources.cpu }}"
        memory: {{ persona.resources.memory }}
